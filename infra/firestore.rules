rules_version = '2';

// Deny-by-default (MC2): clients never talk to Firestore directly — all
// access goes through the Cloud Run API (Admin SDK bypasses these rules),
// which enforces org scoping. Revisit only if a direct-client path is added.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
